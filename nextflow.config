/*
 * Methylation classification — Nextflow port of the Methylation Classification GUI.
 * Every path, model and parameter lives here (or in a -params-file / profile);
 * nothing is hard-coded to one machine.
 */

manifest {
    name            = 'rsankowski/fr-methylclass'
    homePage        = 'https://github.com/rsankowski/fr-methylclass'
    description     = 'crossNN / MethyLYZR / Sturgeon / Lamprey / CNV / rapidCNS2 / metagenomics on nanopore BAMs (EXPERIMENTAL, research use only)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0'
}

params {
    // ---- input / output -----------------------------------------------------
    input            = null        // BAM files / folders (comma-separated) or sample,bam CSV
    group_by         = 'folder'    // folder = one sample per parent dir (ONT bam_pass/<barcode>); file = one per BAM
    outdir           = 'results'
    tools            = 'crossnn,methylyzr,sturgeon,cnv,report'   // or 'all'; lamprey, rapidcns2, metagenomics are opt-in
    patient_id       = ''          // printed on the PDF header (blank = fill-in line)
    publish_dir_mode = 'copy'
    publish_aligned  = true
    continue_on_error = true       // one tool failing for a sample must not abort the others

    // ---- resources ----------------------------------------------------------
    max_cpus         = 32
    max_memory       = '128.GB'
    max_time         = '72.h'
    sort_threads     = 8

    // ---- references ---------------------------------------------------------
    hg19_fasta       = null
    hg38_fasta       = null

    // ---- model / data assets ------------------------------------------------
    // Folder filled by scripts/download_assets.sh; any explicit path below wins.
    assets_dir       = null

    // crossNN (hg19)
    crossnn_genome       = 'hg19'
    crossnn_repo         = '/opt/crossNN'          // NN_model.py inside the crossnn container
    crossnn_model_capper = null                    // Capper_et_al_NN.pkl
    crossnn_model_pancan = null                    // pancan_devel_v5i_NN.pkl
    crossnn_probes       = "${projectDir}/assets/nf/crossnn_probes_hg19_ucsc.bed"
    crossnn_top_n        = 10

    // MethyLYZR (hg38)
    methylyzr_genome   = 'hg38'
    methylyzr_dir      = '/opt/MethyLYZR'           // repo inside the methylyzr container
    methylyzr_epic_bed = null                       // data/EPIC_CpGannotation.bed
    methylyzr_betas    = null                       // model/betas_mean.feather
    methylyzr_weights  = null                       // model/W_RELIEF.feather
    methylyzr_priors   = null                       // model/class_priors.csv

    // Sturgeon (hg38)
    sturgeon_genome           = 'hg38'
    sturgeon_reference_genome = 'hg38'
    sturgeon_model            = null                // general.zip

    // Lamprey (hg38, haematological malignancies)
    lamprey_genome  = 'hg38'
    lamprey_model   = null     // local HF snapshot dir of tachterberg/Lamprey (offline), or a HF repo id
    lamprey_top_n   = 5
    lamprey_keep_pileup = false

    // standalone copy-number (cnvpytor in the rapidCNS2 image)
    cnv_genome = 'hg38'

    // ---- nested pipelines (run on the host: need nextflow + docker) ---------
    nextflow_bin    = 'nextflow'
    nested_workdir  = "${launchDir}/nested-work"   // persistent per-sample launch/work dirs (for -resume)

    rapidcns2_genome       = 'hg38'
    rapidcns2_pipeline     = 'areebapatel/Rapid-CNS2_nf'   // GitHub repo or local main.nf
    rapidcns2_revision     = null
    rapidcns2_nxf_ver      = '24.10.5'
    rapidcns2_profile      = 'local'
    rapidcns2_config       = null
    rapidcns2_meth_threads = 8
    rapidcns2_extra_args   = ''
    annovar_path           = null
    annovar_db             = null
    annotsv_annot          = null
    rapidcns2_annotations  = null     // data/refGene.txt.gz
    rapidcns2_cnv_genes    = null     // data/genes.bed
    rapidcns2_panel        = null     // data/NPHD_panel_hg38.bed

    metagenomics_workflow     = 'epi2me-labs/wf-metagenomics'
    metagenomics_revision     = null
    metagenomics_classifier   = 'kraken2'
    metagenomics_database_set = 'ncbi_16s_18s'
    metagenomics_profile      = 'standard'
    metagenomics_extra_args   = ''

    // ---- containers ---------------------------------------------------------
    container_registry = 'ghcr.io/rsankowski'   // public images; set 'methylclass' for local containers/build.sh builds
    container_tag      = '1.0.0'
    restricted_registry = 'methylclass'     // crossnn/methylyzr/sturgeon/lamprey: licences forbid redistribution, so build locally (containers/build.sh)
    cnvpytor_container = 'areebapatel/rapid_cns@sha256:ad77481d2d4dbcbe7ebd6f8edf9a9d8d58485a704b1ad05fff712198ff0bb15c'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        podman.enabled         = false
        apptainer.enabled      = false
        includeConfig 'conf/containers.config'
    }
    podman {
        podman.enabled         = true
        docker.enabled         = false
        includeConfig 'conf/containers.config'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        includeConfig 'conf/containers.config'
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        docker.enabled         = false
        includeConfig 'conf/containers.config'
    }
    // tools installed natively on the host (paths in the given config)
    host  { includeConfig 'conf/host.config' }
    gpu {
        process {
            withLabel: align { containerOptions = { workflow.containerEngine == 'docker' ? '--gpus all' : '--nv' } }
        }
    }
    slurm { process.executor = 'slurm' }
    test  { includeConfig 'conf/test.config' }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.txt" }
dag      { enabled = false }
