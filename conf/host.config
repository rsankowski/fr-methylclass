/*
 * -profile host : run with the tools already installed on the Freiburg
 * workstation (the paths of the GUI's config.json) — no images to build.
 * Copy this file and adjust the paths for another machine.
 * Software root: /home/roman/software. cnvpytor still runs in the rapidCNS2 docker image.
 */
params {
    hg38_fasta = '/media/roman/vizgen_raw_/Annotations/hg38/hg38.fa'
    hg19_fasta = '/media/roman/vizgen_raw_/Annotations/hg19/hg19.fa'

    crossnn_repo         = "/home/roman/software/crossNN"
    crossnn_model_capper = "/home/roman/software/crossNN/models/Capper_et_al_NN.pkl"
    crossnn_model_pancan = "/home/roman/software/crossNN/models/pancan_devel_v5i_NN.pkl"

    methylyzr_dir      = "/home/roman/software/MethyLYZR"
    methylyzr_epic_bed = "/home/roman/software/MethyLYZR/data/EPIC_CpGannotation.bed"
    methylyzr_betas    = "/home/roman/software/MethyLYZR/model/betas_mean.feather"
    methylyzr_weights  = "/home/roman/software/MethyLYZR/model/W_RELIEF.feather"
    methylyzr_priors   = "/home/roman/software/MethyLYZR/model/class_priors.csv"

    sturgeon_model = "/home/roman/software/sturgeon/sturgeon/include/models/general.zip"

    lamprey_model  = "/home/roman/software/Lamprey/hf_cache/hub/models--tachterberg--Lamprey/snapshots/6167d763c877eb9c19a9ab64b0e8cb4557423cd4"

    nextflow_bin          = "/home/roman/software/nextflow/nextflow"
    rapidcns2_pipeline    = "/home/roman/software/Rapid-CNS2_nf/main.nf"    // locally patched copy
    rapidcns2_config      = '/media/roman/data/Analysis/rapidCNS2/local-parallel.config'
    annovar_path          = "/home/roman/software/annovar"
    annovar_db            = "/home/roman/software/annovar/humandb"
    annotsv_annot         = "/home/roman/software/AnnotSV/Annotations_Human"
    rapidcns2_annotations = "/home/roman/software/Rapid-CNS2_nf/data/refGene.txt.gz"
    rapidcns2_cnv_genes   = "/home/roman/software/Rapid-CNS2_nf/data/genes.bed"
    rapidcns2_panel       = "/home/roman/software/Rapid-CNS2_nf/data/NPHD_panel_hg38.bed"
}

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}

process {
    // native tools: put each environment first on PATH
    withLabel: align     { beforeScript = "export PATH=/home/roman/software/dorado-1.2.0-linux-x64/bin:/home/roman/software/seeksoultools.1.0.0/bin:\$PATH" }
    withLabel: hts       { beforeScript = "export PATH=/home/roman/software/modkit_v0.5.0_u16_x86_64/dist_modkit_v0.5.0_5120ef7:/home/roman/software/seeksoultools.1.0.0/bin:\$PATH:/home/roman/software/seeksoultools.1.3.0/external/conda/bin" }
    withLabel: crossnn   { beforeScript = "export PATH=/home/roman/software/seeksoultools.1.0.0/bin:\$PATH" }
    withLabel: methylyzr { beforeScript = "export PATH=/home/roman/software/MethyLYZR/venv/bin:\$PATH:/home/roman/software/seeksoultools.1.0.0/bin" }
    withLabel: sturgeon  { beforeScript = "export PATH=/home/roman/anaconda3/envs/sturgeon/bin:\$PATH" }
    withLabel: lamprey   { beforeScript = "export PATH=/home/roman/software/Lamprey/venv/bin:/home/roman/software/modkit_v0.5.0_u16_x86_64/dist_modkit_v0.5.0_5120ef7:\$PATH" }
    withLabel: report    { beforeScript = "export PATH=/home/roman/anaconda3/bin:\$PATH" }
    withLabel: cnvpytor  {
        container        = params.cnvpytor_container
        containerOptions = '--user root'
    }
}
