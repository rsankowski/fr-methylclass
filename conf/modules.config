/*
 * Per-process arguments and publish layout. The output tree matches the GUI's:
 *   aligned/<genome>/<sample>/   crossnn/{bedmethyl,results}/   methylyzr/{feather,results}/
 *   sturgeon/{bedmethyl,results/<sample>}/   lamprey/{preprocessed,results}/   cnv/
 *   rapidcns2/results-<sample>/   metagenomics/results-<sample>/   report/
 */
process {
    publishDir = [enabled: false]

    withName: ALIGN {
        publishDir = [path: { "${params.outdir}/aligned/${genome}/${meta.id}" },
                      mode: params.publish_dir_mode, enabled: params.publish_aligned,
                      pattern: '*.sorted.bam*']
    }

    // crossNN
    withName: CROSSNN_PILEUP {
        ext.args   = '--combine-mods'   // sum 5mC (m) + 5hmC (h) into one modified count
        publishDir = [path: { "${params.outdir}/crossnn/bedmethyl" }, mode: params.publish_dir_mode]
    }
    withName: CROSSNN_ANNOTATE {
        publishDir = [path: { "${params.outdir}/crossnn/bedmethyl" }, mode: params.publish_dir_mode]
    }
    withName: CROSSNN_PREDICT {
        publishDir = [path: { "${params.outdir}/crossnn/results" }, mode: params.publish_dir_mode]
    }

    // MethyLYZR
    withName: METHYLYZR_FEATHER {
        publishDir = [path: { "${params.outdir}/methylyzr" }, mode: params.publish_dir_mode]
    }
    withName: METHYLYZR_CLASSIFY {
        publishDir = [path: { "${params.outdir}/methylyzr" }, mode: params.publish_dir_mode]
    }

    // Sturgeon
    withName: STURGEON_PILEUP {
        publishDir = [path: { "${params.outdir}/sturgeon/bedmethyl" }, mode: params.publish_dir_mode]
    }
    withName: STURGEON {
        publishDir = [path: { "${params.outdir}/sturgeon/results" }, mode: params.publish_dir_mode]
    }

    // Lamprey (the pileup is big and only kept on request)
    withName: LAMPREY_PREPROCESS {
        publishDir = [path: { "${params.outdir}/lamprey/preprocessed" }, mode: params.publish_dir_mode,
                      saveAs: { fn -> fn.endsWith('_pileup.bed') && !params.lamprey_keep_pileup ? null : fn }]
    }
    withName: LAMPREY_PREDICT {
        publishDir = [path: { "${params.outdir}/lamprey/results" }, mode: params.publish_dir_mode]
    }

    // copy-number
    withName: 'CNVPYTOR|CNV_SEGMENT_PLOT' {
        publishDir = [path: { "${params.outdir}/cnv" }, mode: params.publish_dir_mode]
    }

    // nested pipelines
    withName: RAPIDCNS2 {
        publishDir = [path: { "${params.outdir}/rapidcns2" }, mode: params.publish_dir_mode,
                      saveAs: { fn -> fn.startsWith('results-') && !fn.contains('/') ? fn : null }]
    }
    withName: RAPIDCNS2_SEGMENT_PLOT {
        publishDir = [path: { "${params.outdir}/rapidcns2/results-${meta.id}/cnv" }, mode: params.publish_dir_mode]
    }
    withName: METAGENOMICS {
        publishDir = [path: { "${params.outdir}/metagenomics" }, mode: params.publish_dir_mode]
    }

    withName: REPORT {
        publishDir = [path: { "${params.outdir}/report" }, mode: params.publish_dir_mode]
    }
}
