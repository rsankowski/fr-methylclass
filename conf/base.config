/*
 * Resources per process label, capped by --max_cpus / --max_memory / --max_time.
 */
process {
    resourceLimits = [cpus: params.max_cpus as int, memory: params.max_memory, time: params.max_time]

    cpus   = 2
    memory = '4.GB'
    time   = '12.h'

    // one tool failing for a sample must not abort the others (as in the GUI)
    errorStrategy = { params.continue_on_error ? 'ignore' : 'terminate' }

    withLabel: align     { cpus = 32; memory = '32.GB'; time = '24.h' }   // minimap2 index of hg38 ~ 10-15 GB
    withLabel: hts       { cpus = 16; memory = '16.GB' }
    withLabel: crossnn   { cpus = 4;  memory = '16.GB' }
    withLabel: methylyzr { cpus = 16; memory = '48.GB'; time = '24.h' }
    withLabel: sturgeon  { cpus = 4;  memory = '16.GB' }
    withLabel: lamprey   { cpus = 16; memory = '32.GB' }
    withLabel: cnvpytor  { cpus = 8;  memory = '16.GB' }
    withLabel: report    { cpus = 1;  memory = '4.GB' }
    // a nested pipeline is a launcher; its own tasks get their own resources
    withLabel: nested    { cpus = 1;  memory = '4.GB'; time = '72.h'; executor = 'local' }

    withName: 'SAMTOOLS_FAIDX|MERGE_RAW|READ_COUNTS' { cpus = 4; memory = '4.GB' }
    // modkit pileup / extract: same thread count the GUI used
    withName: 'CROSSNN_PILEUP|STURGEON_EXTRACT' { cpus = 32 }
}
