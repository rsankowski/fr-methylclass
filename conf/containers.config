/*
 * Container per process label. Images are built from containers/ by
 * containers/build.sh. hts/align/report are public (--container_registry);
 * the classifier images (crossnn, methylyzr, sturgeon, lamprey) contain code whose
 * licences forbid redistribution, so every user builds them locally
 * (--restricted_registry). Singularity/Apptainer pull via docker://, so for those
 * build the classifier images into a private registry you control.
 */
process {
    withLabel: align     { container = "${params.container_registry}/align:${params.container_tag}" }       // dorado 1.2.0 + samtools
    withLabel: hts       { container = "${params.container_registry}/hts:${params.container_tag}" }         // samtools + bedtools + modkit 0.5.0
    withLabel: crossnn   { container = "${params.restricted_registry}/crossnn:${params.container_tag}" }
    withLabel: methylyzr { container = "${params.restricted_registry}/methylyzr:${params.container_tag}" }
    withLabel: sturgeon  { container = "${params.restricted_registry}/sturgeon:${params.container_tag}" }
    withLabel: lamprey   { container = "${params.restricted_registry}/lamprey:${params.container_tag}" }     // includes modkit 0.5.0
    withLabel: report    { container = "${params.container_registry}/report:${params.container_tag}" }
    withLabel: cnvpytor  {
        container        = params.cnvpytor_container
        // cnvpytor in this image expects root (writes into its package dir)
        containerOptions = { workflow.containerEngine == 'docker' ? '--user root' : '' }
    }
    withLabel: nested    { container = null }   // runs host nextflow + its own engine
}
