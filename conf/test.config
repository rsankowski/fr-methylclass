/*
 * -profile test : wiring check with dummy inputs (combine with -stub-run).
 *   nextflow run main.nf -profile test -stub-run
 */
params {
    input                = "${projectDir}/tests/data/bam_pass"
    outdir               = 'test-results'
    tools                = 'all'
    hg19_fasta           = "${projectDir}/tests/data/ref/hg19.fa"
    hg38_fasta           = "${projectDir}/tests/data/ref/hg38.fa"
    assets_dir           = "${projectDir}/tests/data/assets"
    lamprey_model        = "${projectDir}/tests/data/assets/lamprey/model"
    nested_workdir       = "${launchDir}/test-nested-work"
    max_cpus             = 2
    max_memory           = '4.GB'
}
